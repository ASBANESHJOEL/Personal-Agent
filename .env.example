# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Backend
APP_ENV=development
DATABASE_URL=sqlite:///./personal_agent.db
# SQLite is for local development/tests only; set supabase for deployed API/worker state.
AGENT_STATE_STORAGE=sqlite
SUPABASE_URL=your-supabase-project-url
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Leave blank for asymmetric signing keys; the backend fetches the project's trusted JWKS.
SUPABASE_JWT_SECRET=
# Optional trusted JWKS endpoint override; defaults to SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_URL=
SUPABASE_REQUEST_TIMEOUT_SECONDS=3
DISCOVERY_REQUEST_TIMEOUT_SECONDS=8
SCHEDULED_DISCOVERY_HOUR_UTC=3
SCHEDULED_DISCOVERY_WORKER_DEPLOYED=false
SCHEDULED_DISCOVERY_LEASE_SECONDS=1800
# Optional public-repository search rate-limit increase. Server-side only; no write scopes needed.
GITHUB_TOKEN=
# Cron service only. Do not set this on the API service or in any NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:3000
